  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Merge Fact_Reviews"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{10412141-6FA0-417D-AB7D-0A8D569088B0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Merge Fact_Reviews"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C1419EA5-4198-41CA-8EF4-40D87A1725FD}"
          SQLTask:SqlStatementSource="merge DwOlist.dbo.Fact_Reviews tgt&#xA;using (&#xA;&#xA;select &#xA;      do.sk_order       as sk_order&#xA;    , dr.sk_review      as sk_review&#xA;    , [or].review_score as review_score&#xA;from&#xA;    olist.order_reviews [or] &#xA;&#xA;    inner join DwOlist.dbo.Dim_Order do&#xA;        on [or].order_id = do.bk_order_id&#xA;    &#xA;    inner join DwOlist.dbo.Dim_Reviews dr&#xA;        on dr.bk_review_id = [or].review_id&#xA;&#xA;) as src &#xA;    on tgt.sk_review = src.sk_review&#xA;&#xA;when matched and tgt.review_score is distinct from src.review_score&#xA;    then update set tgt.review_score = src.review_score&#xA;&#xA;when not matched then &#xA;    insert (&#xA;          sk_review&#xA;        , review_score       &#xA;    )&#xA;    values (&#xA;          src.sk_review&#xA;        , src.review_score&#xA;    );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
